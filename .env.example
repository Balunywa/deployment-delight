# Control-plane database: Azure Database for PostgreSQL Flexible Server.
# Option A — Microsoft Entra auth (recommended on Azure: managed identity / workload identity / az login):
#   DATABASE_URL=postgres://<entra-principal-name>@<server>.postgres.database.azure.com:5432/cloud_delivery
#   AZURE_POSTGRES_ENTRA_AUTH=true
# Option B — password auth:
#   DATABASE_URL=postgres://<user>:<password>@<server>.postgres.database.azure.com:5432/cloud_delivery
# Local development (docker compose up -d):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cloud_delivery
PGSSLMODE=disable

# Optional: AI architecture drafting (any OpenAI-compatible endpoint, e.g. Azure OpenAI)
# AI_CHAT_COMPLETIONS_URL=https://<resource>.openai.azure.com/openai/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=gpt-4.1
