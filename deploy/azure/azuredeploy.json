{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "9028012010397067037"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "clouddelivery",
      "minLength": 3,
      "maxLength": 16,
      "metadata": {
        "description": "Short name used to build resource names."
      }
    },
    "appServiceSku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "B2",
        "P0v3",
        "P1v3"
      ],
      "metadata": {
        "description": "App Service plan size."
      }
    },
    "postgresSku": {
      "type": "string",
      "defaultValue": "Standard_B1ms",
      "allowedValues": [
        "Standard_B1ms",
        "Standard_B2s",
        "Standard_D2ds_v5"
      ],
      "metadata": {
        "description": "PostgreSQL compute size."
      }
    },
    "databaseAuth": {
      "type": "string",
      "defaultValue": "entra",
      "allowedValues": [
        "entra",
        "password"
      ],
      "metadata": {
        "description": "How the app signs in to PostgreSQL: entra (managed identity, no password) or password."
      }
    },
    "administratorLogin": {
      "type": "string",
      "defaultValue": "cdadmin",
      "metadata": {
        "description": "PostgreSQL administrator login (password auth only)."
      }
    },
    "administratorLoginPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "PostgreSQL administrator password (password auth only)."
      }
    },
    "seedDemoData": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Load the GridWorks demo data into the empty database on first start."
      }
    },
    "packageUrl": {
      "type": "string",
      "defaultValue": "https://github.com/Balunywa/deployment-delight/releases/download/app-latest/cloud-delivery-app.zip",
      "metadata": {
        "description": "URL of the prebuilt app package (release asset built by .github/workflows/release-app.yml)."
      }
    }
  },
  "variables": {
    "suffix": "[take(uniqueString(resourceGroup().id, parameters('namePrefix')), 6)]",
    "webAppName": "[format('{0}-{1}', parameters('namePrefix'), variables('suffix'))]",
    "planName": "[format('{0}-plan-{1}', parameters('namePrefix'), variables('suffix'))]",
    "postgresName": "[format('{0}-pg-{1}', parameters('namePrefix'), variables('suffix'))]",
    "keyVaultName": "[take(format('cd-kv-{0}', uniqueString(resourceGroup().id, parameters('namePrefix'))), 24)]",
    "insightsName": "[format('{0}-ai-{1}', parameters('namePrefix'), variables('suffix'))]",
    "workspaceName": "[format('{0}-law-{1}', parameters('namePrefix'), variables('suffix'))]",
    "databaseName": "cloud_delivery",
    "useEntra": "[equals(parameters('databaseAuth'), 'entra')]",
    "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('workspaceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('insightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('workspaceName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[variables('postgresName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('postgresSku')]",
        "tier": "[if(startsWith(parameters('postgresSku'), 'Standard_B'), 'Burstable', 'GeneralPurpose')]"
      },
      "properties": {
        "version": "16",
        "storage": {
          "storageSizeGB": 32,
          "autoGrow": "Enabled"
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        },
        "authConfig": {
          "activeDirectoryAuth": "[if(variables('useEntra'), 'Enabled', 'Disabled')]",
          "passwordAuth": "[if(variables('useEntra'), 'Disabled', 'Enabled')]",
          "tenantId": "[if(variables('useEntra'), subscription().tenantId, null())]"
        },
        "administratorLogin": "[if(variables('useEntra'), null(), parameters('administratorLogin'))]",
        "administratorLoginPassword": "[if(variables('useEntra'), null(), parameters('administratorLoginPassword'))]"
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', variables('postgresName'), 'AllowAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "[parameters('appServiceSku')]"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "condition": "[not(variables('useEntra'))]",
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7
      }
    },
    {
      "condition": "[not(variables('useEntra'))]",
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'database-url')]",
      "properties": {
        "value": "[format('postgres://{0}:{1}@{2}:5432/{3}', parameters('administratorLogin'), uriComponent(parameters('administratorLoginPassword')), reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName')), '2024-08-01').fullyQualifiedDomainName, variables('databaseName'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('webAppName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "keyVaultReferenceIdentity": "SystemAssigned",
        "siteConfig": {
          "linuxFxVersion": "NODE|22-lts",
          "appCommandLine": "node .output/server/index.mjs",
          "alwaysOn": "[not(equals(parameters('appServiceSku'), 'B1'))]",
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "http20Enabled": true,
          "healthCheckPath": "/",
          "appSettings": "[concat(createArray(createObject('name', 'WEBSITE_RUN_FROM_PACKAGE', 'value', parameters('packageUrl')), createObject('name', 'SCM_DO_BUILD_DURING_DEPLOYMENT', 'value', 'false'), createObject('name', 'NODE_ENV', 'value', 'production'), createObject('name', 'PORT', 'value', '8080'), createObject('name', 'WEBSITES_PORT', 'value', '8080'), createObject('name', 'AUTO_MIGRATE', 'value', 'true'), createObject('name', 'SEED_DEMO_DATA', 'value', string(parameters('seedDemoData'))), createObject('name', 'APPLICATIONINSIGHTS_CONNECTION_STRING', 'value', reference(resourceId('Microsoft.Insights/components', variables('insightsName')), '2020-02-02').ConnectionString), createObject('name', 'ApplicationInsightsAgent_EXTENSION_VERSION', 'value', '~3')), if(variables('useEntra'), createArray(createObject('name', 'DATABASE_URL', 'value', format('postgres://{0}@{1}:5432/{2}', variables('webAppName'), reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName')), '2024-08-01').fullyQualifiedDomainName, variables('databaseName'))), createObject('name', 'AZURE_POSTGRES_ENTRA_AUTH', 'value', 'true')), createArray(createObject('name', 'DATABASE_URL', 'value', format('@Microsoft.KeyVault(SecretUri=https://{0}{1}/secrets/database-url)', variables('keyVaultName'), environment().suffixes.keyvaultDns)))))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/firewallRules', variables('postgresName'), 'AllowAzureServices')]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), 'database-url')]",
        "[resourceId('Microsoft.Insights/components', variables('insightsName'))]",
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName'))]"
      ]
    },
    {
      "condition": "[not(variables('useEntra'))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
      "name": "[guid(variables('keyVaultName'), variables('webAppName'), variables('keyVaultSecretsUserRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('webAppName')), '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleId'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.Web/sites', variables('webAppName'))]"
      ]
    },
    {
      "condition": "[variables('useEntra')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "postgres-entra-admin",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "serverName": {
            "value": "[variables('postgresName')]"
          },
          "principalId": {
            "value": "[reference(resourceId('Microsoft.Web/sites', variables('webAppName')), '2023-12-01', 'full').identity.principalId]"
          },
          "principalName": {
            "value": "[variables('webAppName')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.44.1.10279",
              "templateHash": "2620106018408095597"
            }
          },
          "parameters": {
            "serverName": {
              "type": "string"
            },
            "principalId": {
              "type": "string"
            },
            "principalName": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.DBforPostgreSQL/flexibleServers/administrators",
              "apiVersion": "2024-08-01",
              "name": "[format('{0}/{1}', parameters('serverName'), parameters('principalId'))]",
              "properties": {
                "principalType": "ServicePrincipal",
                "principalName": "[parameters('principalName')]",
                "tenantId": "[subscription().tenantId]"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/firewallRules', variables('postgresName'), 'AllowAzureServices')]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName'))]",
        "[resourceId('Microsoft.Web/sites', variables('webAppName'))]"
      ]
    }
  ],
  "outputs": {
    "webAppName": {
      "type": "string",
      "value": "[variables('webAppName')]"
    },
    "webAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('webAppName')), '2023-12-01').defaultHostName)]"
    },
    "postgresServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresName')), '2024-08-01').fullyQualifiedDomainName]"
    },
    "databaseAuth": {
      "type": "string",
      "value": "[parameters('databaseAuth')]"
    }
  }
}