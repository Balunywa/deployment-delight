{
  "inputs": [
    {
      "id": "cloud-delivery-token",
      "type": "promptString",
      "description": "Cloud Delivery MCP token (in the app: Settings → Connect Copilot → Copy token)",
      "password": true
    }
  ],
  "servers": {
    "msx": {
      "type": "stdio",
      "command": "node",
      "args": ["${userHome}/msx-mcp/bundle/msx.mjs"]
    },
    "cloud-delivery": {
      "type": "http",
      "url": "http://127.0.0.1:47616/api/mcp",
      "headers": { "Authorization": "Bearer ${input:cloud-delivery-token}" }
    }
  }
}
